# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Daily quota budget. Default for a new project is 10000 units/day (resets at
# midnight Pacific time, roughly 16:00-17:00 JST). Leave some headroom.
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_SAFETY_MARGIN=300

# Transcript backend: local | hosted | null
#   local  - youtube-transcript-api. Verification only, from a residential IP,
#            low frequency. Datacenter IPs get IpBlocked, and so does a home IP
#            if requests are too frequent (4 s interval was blocked after ~17).
#   hosted - paid hosted transcript API (stub, not implemented yet)
#   null   - no transcripts; metadata-only features
TRANSCRIPT_BACKEND=local
TRANSCRIPT_MIN_INTERVAL_SEC=30
TRANSCRIPT_MAX_RETRIES=3

# LLM used to name format clusters (optional). The LLM is called ONLY when this
# key is set here; otherwise rule-based names are used. Machine-wide Anthropic
# credentials (e.g. a work profile) are never picked up implicitly.
ANTHROPIC_API_KEY=
SFA_LLM_MODEL=claude-sonnet-5

# Region / language for search
YOUTUBE_REGION_CODE=JP
YOUTUBE_RELEVANCE_LANGUAGE=ja

# Paths
SFA_DB_PATH=data/sfa.db
SFA_QUOTA_PATH=data/quota.json
SFA_OUT_DIR=out
